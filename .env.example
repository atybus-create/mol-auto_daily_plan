MOL_APP_PASSWORD_HASH=ustaw_hash_sha256_w_vercelu

# Losowy sekret o długości co najmniej 32 znaków do podpisywania sesji.
MOL_SESSION_SECRET=ustaw_niezalezny_losowy_sekret_w_vercelu

